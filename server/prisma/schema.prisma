generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  tickets    Ticket[]
  categories Category[]
  labels     Label[]
  canvas     CanvasIntegration?
  events     CalendarEvent[]
  feeds      CalendarFeed[]
  channels   TvChannel[]
  notebooks  Notebook[]
  collections Collection[]
  papers      Paper[]
  entries     LedgerEntry[]
  jobSearches JobSearch[]
  jobPostings JobPosting[]
  resumes     Resume[]

  sentInvites     Connection[]  @relation("connRequester")
  receivedInvites Connection[]  @relation("connAddressee")
  notesWritten    PartnerNote[] @relation("noteAuthor")
  notesReceived   PartnerNote[] @relation("noteRecipient")
}

// Two accounts linked for the face-off — invite by email, other side accepts
model Connection {
  id          String    @id @default(uuid())
  requester   User      @relation("connRequester", fields: [requesterId], references: [id])
  requesterId String
  addressee   User      @relation("connAddressee", fields: [addresseeId], references: [id])
  addresseeId String
  status      String    @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([requesterId])
  @@index([addresseeId])
}

model PartnerNote {
  id          String   @id @default(uuid())
  body        String
  author      User     @relation("noteAuthor", fields: [authorId], references: [id])
  authorId    String
  recipient   User     @relation("noteRecipient", fields: [recipientId], references: [id])
  recipientId String
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
}

model TvChannel {
  id        String   @id @default(uuid())
  name      String   // ≤20 chars, enforced at the API
  src       String   // youtube embed URL
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model CalendarFeed {
  id           String    @id @default(uuid())
  url          String
  label        String?
  kind         String    @default("ics") // google | apple | ics
  lastSyncedAt DateTime?
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime  @default(now())
}

model CalendarEvent {
  id         String   @id @default(uuid())
  title      String
  date       String   // "YYYY-MM-DD" — wall calendars think in days, not timestamps
  time       String?  // "HH:MM" — wall-clock time when the event has one
  timeIsUtc  Boolean  @default(false) // true when time came from an ICS UTC stamp; client localizes
  hidden     Boolean  @default(false) // user removed a synced event from the wall; survives re-sync
  note       String?
  imageUrl   String?
  source     String   @default("manual") // manual | google | ics
  externalId String?  // dedupe key for synced events
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model Ticket {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  status             String    @default("BACKLOG")
  priority           String    @default("MEDIUM")
  category           Category  @relation(fields: [categoryId], references: [id])
  categoryId         String
  labels             Label[]
  dueDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Int       @default(0)
  canvasAssignmentId String?
  canvasCourseId     String?
  user               User      @relation(fields: [userId], references: [id])
  userId             String

  @@index([status])
  @@index([categoryId])
  @@index([priority])
  @@index([userId])
  @@index([canvasAssignmentId])
}

model Category {
  id      String   @id @default(uuid())
  name    String
  color   String   @default("#000000")
  icon    String   @default("folder")
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  tickets Ticket[]

  @@unique([name, userId])
}

model Label {
  id      String   @id @default(uuid())
  name    String
  color   String   @default("#000000")
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  tickets Ticket[]

  @@unique([name, userId])
}

model CanvasIntegration {
  id        String   @id @default(uuid())
  baseUrl   String
  apiToken  String
  userId    String   @unique
  userName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

// ── The Study: vintage notebooks ──────────────────────────────
// A page's content is one JSON document ({ v, items }) — items are
// heterogeneous (text/ink/image/sticker) and the page is the atomic
// load/save/undo unit, so per-item rows would buy nothing. See ADR-0004.

model Notebook {
  id         String   @id @default(uuid())
  title      String
  coverStyle String   @default("composition") // composition | cloth | leather | kraft
  paperStyle String   @default("ruled") // ruled | grid | dot | plain
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages      NotebookPage[]

  @@index([userId, updatedAt])
}

model NotebookPage {
  id         String   @id @default(uuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  pageNumber Int
  content    Json     @default("{\"v\": 1, \"items\": []}")
  updatedAt  DateTime @updatedAt

  @@unique([notebookId, pageNumber])
}

// ── The Study: reading room (papers + annotations) ────────────
// Page text is extracted client-side by pdfjs and stored per page for
// FTS retrieval; annotation rects are % of the rendered page box so
// they survive any zoom. See ADR-0005.

model Collection {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers    Paper[]
  createdAt DateTime @default(now())

  @@unique([name, userId])
}

model Paper {
  id           String      @id @default(uuid())
  title        String
  authors      String      @default("")
  year         Int?
  blobUrl      String
  fileName     String      @default("")
  pageCount    Int         @default(0)
  status       String      @default("processing") // processing | ready | scanned
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pages        PaperPage[]
  annotations  Annotation[]

  @@index([userId, updatedAt])
}

model PaperPage {
  id         String @id @default(uuid())
  paperId    String
  paper      Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  pageNumber Int
  text       String

  @@unique([paperId, pageNumber])
}

model Annotation {
  id        String   @id @default(uuid())
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  page      Int
  rects     Json     // [{x,y,w,h}] as % of the rendered page box — zoom-invariant
  quote     String
  note      String   @default("")
  color     String   @default("marigold") // marigold | rose | sage | ink
  createdAt DateTime @default(now())

  @@index([paperId, page])
}

// ── The Accounts: the household book ──────────────────────────
// One row per line in the book. `amount` is always positive and
// `kind` carries the sign, so the column foots without sign errors
// on import. `externalKey` is a per-user dedupe hash so re-importing
// the same statement is idempotent (NULLs are distinct in Postgres,
// so hand-typed lines never collide). See ADR-0007.

// ── The Classifieds: the jobs wire ────────────────────────────
// A standing order is a saved search the morning wire runs for; a
// posting is one classified that survived the wire clerk's vetting.
// Postings are never deleted by the wire — `hidden` (spiked) persists
// across re-fetches, and the (userId, externalId) unique key makes
// the daily upsert idempotent. See ADR-0006.

model JobSearch {
  id        String    @id @default(uuid())
  keywords  String
  location  String    @default("")
  country   String    @default("us") // adzuna wants a country code in the path
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model JobPosting {
  id          String    @id @default(uuid())
  externalId  String
  title       String
  company     String    @default("")
  location    String    @default("")
  url         String
  salary      String    @default("") // display string; adzuna's numbers are too patchy to keep raw
  description String    @default("")
  source      String    @default("adzuna")
  search      String    @default("") // the standing order's keywords at fetch time
  verdict     String    @default("") // the wire clerk's one-line reason it made the column
  postedAt    DateTime?
  fetchedAt   DateTime  @default(now())
  status      String    @default("new") // new | seen | applied | hidden
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, status, fetchedAt])
}

// A master resume for the rewrite desk. Only the master is ever stored;
// tailored copies live in the browser and leave as downloads. See ADR-0009.
model Resume {
  id        String   @id @default(uuid())
  name      String
  blobUrl   String
  fileName  String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LedgerEntry {
  id          String   @id @default(uuid())
  kind        String   @default("expense") // expense | income
  amount      Decimal  @db.Decimal(12, 2) // money is never a Float
  category    String   @default("uncategorized")
  description String   @default("")
  date        DateTime
  source      String   @default("manual") // manual | csv | vera
  externalKey String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, externalKey])
  @@index([userId, date])
}
